# Shared
APP_ENV=development
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://company_app:company_app_password@postgres:5432/company_app
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ADMIN_SESSION_COOKIE_NAME=admin_session
RATE_LIMIT_PER_MINUTE=60
ADMIN_EMAIL=admin@example.co.uk
ADMIN_PASSWORD_HASH=

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.co.uk
ADMIN_NOTIFICATION_EMAIL=admin@example.co.uk
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_COMPANY_NAME=VenusCore
NEXT_PUBLIC_COMPANY_PHONE=UK Phone Number
NEXT_PUBLIC_COMPANY_EMAIL=Business Email
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_GA_MEASUREMENT_ID=
